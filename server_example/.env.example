# Use a local service account file; never commit the JSON key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
JACKFIELD_API_TOKEN=replace-with-long-random-control-token
JACKFIELD_CALLBACK_TOKEN=replace-with-different-long-random-callback-token
JACKFIELD_LISTEN_ADDR=127.0.0.1:8080
JACKFIELD_FCM_TTL=90s
